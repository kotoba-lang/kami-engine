{:paths ["src"]
 ;; The multirotor mass spiral, over the three sizing solvers. Thrust equals
 ;; weight on a rotorcraft, so mass appears on both sides of the loop and the
 ;; fixed point is not guaranteed to exist — this library's job is to find it
 ;; when it does and to REFUSE when it does not.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.test"}io.github.kotoba-lang/datom
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.datom"}
        io.github.kotoba-lang/kami-engine-cae-solver {:local/root "../kami-engine-cae-solver"}
        io.github.kotoba-lang/kami-engine-rotor      {:local/root "../kami-engine-rotor"}
        io.github.kotoba-lang/kami-engine-pack       {:local/root "../kami-engine-pack"}
        io.github.kotoba-lang/kami-engine-motor      {:local/root "../kami-engine-motor"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :dev {:override-deps {io.github.kotoba-lang/datom                  {:local/root "../datom"}
                        io.github.kotoba-lang/kami-engine-cae-solver {:local/root "../kami-engine-cae-solver"}
                        io.github.kotoba-lang/kami-engine-rotor      {:local/root "../kami-engine-rotor"}
                        io.github.kotoba-lang/kami-engine-pack       {:local/root "../kami-engine-pack"}
                        io.github.kotoba-lang/kami-engine-motor      {:local/root "../kami-engine-motor"}}}}}
