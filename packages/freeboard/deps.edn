;; freeboard — an Apple-Freeform-style infinite-canvas board.
;; clj/cljc is the brain (board model + ops); browser/render hosts consume the
;; render-IR as external adapters. kasane imports design files (PSD/PDF/PNG/
;; SVG/…) onto the canvas; kotoba is the content-addressed durable +
;; collaborative layer.
;; See ADR-2606280200.
{:paths ["src" "resources"]

 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.text"}
        ;; engine SDK: scene/ecs/render-IR contract for host adapters
        ;; ADR-2607102200: always depend on standalone kami-engine-sdk,
        ;; never the nested monorepo leftover under kami-engine/.
        io.github.kotoba-lang/kami-engine-sdk
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.kamiEngineSdk"}
        ;; design-file importer (PSD/PDF/AI/PNG/SVG/Sketch/OOXML/…)
        io.github.kotoba-lang/kasane
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.kasane"}
        ;; viewport interaction math (UIScrollView semantics), ADR-2607071130
        io.github.kotoba-lang/canvaskit
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.canvaskit"}}

 :aliases
 {      ; freeboard.schema (validation)
  :test   {:extra-paths ["test"]}}}