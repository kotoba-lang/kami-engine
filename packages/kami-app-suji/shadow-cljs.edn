;; One build, one module, one init-fn: kami-app-suji is a single-page app
;; (the kotoba-lang default, ADR-2608080100). Views are values in
;; `kami.app-suji.route`, not documents.
{:deps {:aliases [:cljs]}
 :builds {:app {:target :browser
                :output-dir "public/js"
                :asset-path "js"
                :modules {:main {:init-fn kami.app-suji.ui/init!}}
                :release {:compiler-options {:optimizations :simple}}}}}
