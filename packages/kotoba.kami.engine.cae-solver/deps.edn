{:paths ["src" "resources"]
 ;; Zero-dep, portable .cljc. The CAE solver CONTRACT — one `solve` multimethod
 ;; dispatching on [:solver :kind], so a case can be answered by a reduced-order
 ;; backend (:cfd/:fem/:process/:materials/:emag/:production-des) today and a
 ;; high-fidelity host adapter tomorrow with no caller change. Purpose: SOLVER DISPATCH only (no physics,
 ;; no datoms — those are vphysics-clj and datom-clj).
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error {:git/sha "838dec56c9a5b74f9eec825a2fb28bda157f8cd3"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "72dde04b4c32854d70d17a670b277f8f7957a784"}
        ;; kotoba.json replaced clojure.data.json here (2026-09-24). An explicit
        ;; floor: kotoba.json/read-str and /write-str first exist at 9c11ad1, and
        ;; tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/json {:git/sha "9c11ad189e64907700e8b4eb9b26f40336bffa01"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/i18n
        {:git/url "https://github.com/kotoba-lang/i18n.git"
         :git/sha "277cb404928392e01b257cbc0c48a2a304e2a6d1"}
        io.github.kotoba-lang/physics
        {:git/url "https://github.com/kotoba-lang/physics.git"
         :git/sha "30278f1f54ecf1de1f5da5242cae2bd9cc71aa38"}
        ;; Replaces ad-hoc clojure.edn usage with the bounded, hardened EDN reader.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/edn.git"
         :git/sha "250f4dafa5f5c7fb3109703496a52866e2a62dcd"}}
 :aliases
 {:dataset {:extra-paths ["scripts"]}
  :pages {:extra-paths ["scripts"]
          :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                       hiccup/hiccup {:mvn/version "2.0.0"}
                       org.clojure/data.json {:mvn/version "2.5.1"}
                       com.thheller/shadow-css {:mvn/version "0.6.3"}}}
  :test {:extra-paths ["test"]
         :extra-deps {datascript/datascript {:mvn/version "1.7.8"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
