{:paths ["src"]
 ;; Zero-Rust, portable .cljc. Domain model (tank/process) + the mixing-tank CFD
 ;; scenario, wired through kami-engine-cae-solver's `cae.solver/solve` multimethod
 ;; contract and driven by nagare's finite-volume incompressible-NS + scalar-transport
 ;; kernel. See README.md "Render status" for why kami.webgpu/kami.gpu (kotoba-lang/webgpu)
 ;; is NOT declared in the BASE :deps map here (kept standalone-resolvable for
 ;; `kbb -M:test`/`-M:lint` — see docs/adr/0001-architecture.md Decision 4 /
 ;; 2026-07-18 addendum). It is added ONLY under the `:cljs` alias below, which is
 ;; only meaningful inside the west-managed `kotoba-lang` sibling checkout anyway.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.test"}io.github.kotoba-lang/nagare
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.nagare"}
        ;; cae-solver lives in the kotoba monorepo (lib/kotoba.kamiEngineCaeSolver, JUN-649).
        io.github.kotoba-lang/kami-engine-cae-solver
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "1253cd8ba563fdc43a8023f0f735ca69ff4d6476"
         :deps/root "lib/kotoba.kamiEngineCaeSolver"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
