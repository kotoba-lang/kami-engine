{:deps {:aliases [:cljs]}
 :builds
 {:app {:target :browser
        :output-dir "public/js"
        :asset-path "js"
        :modules {:main {:init-fn kami.creative-studio.ui/init!}}
        ;; VRM/GLB and browser GPU interop method names must remain stable.
        ;; :simple also avoids Closure's whole-program advanced pass exhausting
        ;; memory when the portable compositor is included.
        :release {:compiler-options {:optimizations :simple}}}}}
