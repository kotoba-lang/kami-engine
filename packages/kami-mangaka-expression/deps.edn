;; kami-mangaka-expression-clj — work-agnostic manga EXPRESSION patterns.
;;
;; 「キャラクターごとに、表情・姿勢・吹き出しの形・文字の薄さ・大きさ・背景トーンを
;;  変える」漫画的表現を DATA (resources/mangaka_expression_patterns.edn) から決める
;; 純粋レイヤ。archetype ← register ← expression-cue ← intensity を merge して 1 行分の
;; スタイルを解決し (resolve-style)、storyboard に当てる (analyze-line/panel/page)。
;; 出典は HUNTER×HUNTER 王位継承戦編のコマ観察 (ADR-2607012100)。
;;
;; 純 clj/cljc — babashka-safe, GPU/AWT なし。SEMANTIC タグだけを吐き、見た目への写像は
;; renderer 側 (kami-mangaka-text-clj の hiccup+CSS / kami-mangaka-page-clj の Java2D)。
;; langgraph の ai.gftd.mangaka.analyzeExpression がこの analyze-page を呼ぶ。
;; Sibling of kami-mangaka-text-clj / -page-clj / -scene-clj。ADR-2606282100/101。
{:paths ["src" "resources"]

 :deps {
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.text"}}

 :aliases
 {:test {:extra-paths ["test"]}
}}
