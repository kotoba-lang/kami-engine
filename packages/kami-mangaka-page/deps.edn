;; kami-mangaka-page — work-agnostic graphic-novel PAGE composition.
;;
;; The komawari (コマ割り) + DTP half: place rendered panel images into a B5 page,
;; draw frames + gutters, overlay dialogue bubbles + narration captions. Ported
;; from mangaka.gftd.ai's manga-layouts.ts GRAPHIC_NOVEL_TEMPLATES (ADR-2606282100).
;; JVM/Java2D headless — no Canvas-2D, no GPU; this is page DTP, not the wgpu path.
;;
;; Sibling of kami-mangaka-render (2D panels) and kami-mangaka-scene (3D).
{:paths ["src"]

 :deps {
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.text"}
        ;; shared multilingual lettering layer (locale-keyed MangaText)
        gftd/kami-mangaka-text {:git/url "https://github.com/kotoba-lang/kami-mangaka-text.git"
                                :sha "e575d147533d4a490d71b6e86876d900aa89d50b"}}

 :aliases
 {:test {:extra-paths ["test"]}}}
