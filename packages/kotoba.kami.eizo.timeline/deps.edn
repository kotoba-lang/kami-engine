{:paths ["src"]
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}org.clojure/clojure {:mvn/version "1.11.1"}
        org.clojure/clojurescript {:mvn/version "1.11.132"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.03.13"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}
  ;; Real-browser render-proof E2E (test/e2e/, ADR-2607121400): compiles
  ;; kami.eizo.timeline.e2e.entry, which pulls in both this repo's own
  ;; timeline query layer and org-w3-webcodecs's raw WebCodecs binding, into
  ;; one browser bundle via scripts/build-e2e-bundle.sh. See test/e2e/ and
  ;; the README's "Real-browser render proof" section.
  :e2e {:extra-paths ["test/e2e/src"]
        :extra-deps {io.github.kotoba-lang/org-w3-webcodecs
                     {:git/sha "b14dc397e248f5aab0f5ad9e7845e2f80b2cf5a3"}}}}}
