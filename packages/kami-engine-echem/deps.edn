{:paths ["src"]
 ;; Reduced-order PEM fuel-cell solver on the shared, purpose-split libs.
 ;; Registers :rom-fc on the cae-solver contract; turns the FCEV's fixed stack
 ;; efficiency (0.53) into a polarization-curve result → real H2 consumption.
 ;; The proper "combustion" analog for EV/FCEV is electrochemistry. A detailed
 ;; kami-echem CFD/electrochem model registers :pemfc-cfd on the same contract.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/datom                {:git/sha "d27a5833d59d909367956705f2ec931399c891ee"}
        io.github.kotoba-lang/kami-engine-cae-solver {:local/root "../kami-engine-cae-solver"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :dev {:override-deps {io.github.kotoba-lang/datom                {:local/root "../datom"}
                        io.github.kotoba-lang/kami-engine-cae-solver {:local/root "../kami-engine-cae-solver"}}}}}
