{:paths ["src"]
 ;; west checks this repo out as a sibling of orgs/kotoba-lang/{bim,scene,
 ;; kami-atmosphere-scene,kami-vegetation-scene,kami-terrain-scene,
 ;; kami-postfx-scene,usd,materialx,webgpu,atmosphere,org-w3-webgpu,expr},
 ;; so relative :local/root resolves (ADR-2607100100 M0/M1/M2).
 ;; org-w3-webgpu + expr aren't required directly by this repo's own code —
 ;; they're webgpu's OWN :local/root deps (org-w3-webgpu = the raw
 ;; navigator.gpu binding kami.webgpu.cljs now calls through, ADR-2607051400;
 ;; expr = kami.wgsl's shared infix-expression core, ADR-2607051500) and
 ;; tools.deps resolves a :local/root's own :deps transitively, so they must
 ;; be checkout-present too (a real CI break found+fixed this session: the
 ;; local orgs/kotoba-lang/webgpu checkout was stale and didn't yet declare
 ;; these when M2 was first implemented).
 :deps {
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/bim
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.bim"}
        io.github.kotoba-lang/atmosphere-scene   {:local/root "../kami-atmosphere-scene"}
        io.github.kotoba-lang/vegetation-scene   {:local/root "../kami-vegetation-scene"}
        io.github.kotoba-lang/terrain-scene      {:local/root "../kami-terrain-scene"}
        io.github.kotoba-lang/postfx-scene       {:local/root "../kami-postfx-scene"}
        io.github.kotoba-lang/usd                {:git/url "https://github.com/kotoba-lang/org-openusd.git"
                                     :git/sha "2f1f2b4e3b5cf48413751c1ea5e70b0e898eef76"}
        io.github.kotoba-lang/materialx          {:git/url "https://github.com/kotoba-lang/org-materialx.git"
                                     :git/sha "710b77dc9f758a59992c859634abeb23c10290eb"}
        io.github.kotoba-lang/webgpu
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.webgpu"}
        io.github.kotoba-lang/atmosphere
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.atmosphere"}
        io.github.kotoba-lang/org-w3-webgpu
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/org.w3.webgpu"}
        io.github.kotoba-lang/expr
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.expr"}
        ;; M5 (ADR-2607100100): the org's default UI/UX design system
        ;; (ADR-2607022800) — appkit is the only DIRECT dep needed; it
        ;; transitively pulls kotoba-ui -> {shitsuke, liquid-glass-ui} via
        ;; their own deps.edn :local/root chains (confirmed working
        ;; end-to-end in murakumo-studio/local-manimani, both real deployed
        ;; apps on this exact stack) — no need to list those three here too.
        io.github.kotoba-lang/appkit
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.appkit"}
        ;; M7 (ADR-2607100100): glTF export. org-khronos-gltf's own deps.edn
        ;; pulls org-khronos-glb via a :git/sha coordinate (not :local/root),
        ;; so tools.deps resolves it itself — no sibling checkout needed here.
        io.github.kotoba-lang/org-khronos-gltf
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/org.khronos.gltf"}
        io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.html"}
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.css"}}
 :aliases
 {:test {:extra-paths ["test"]}}}