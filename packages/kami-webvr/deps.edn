{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee9a3f386fc046f5ff2fb3f1526df5ef5bc2ada9"
         :deps/root "lib/kotoba.test"}
        io.github.kotoba-lang/text {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee9a3f386fc046f5ff2fb3f1526df5ef5bc2ada9"
         :deps/root "lib/kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  ;; shadow-cljs's :node-test build's classpath needs cljs-test/ added, kept
  ;; separate from :test (which cognitect.test-runner scans on the JVM) since
  ;; cljs-test/ uses cljs.test/npm-only syntax -- same split kami-genko uses.
  :cljs-test {:extra-paths ["cljs-test"]}}}
