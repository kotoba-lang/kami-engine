;; author.clj -- kami-genre-base-systems / modern-remake, scene authoring.
;;   kbb -M author.clj
;;
;; NOTE: "modern-remake" is not a gameplay archetype (see design/
;; modern-remake.edn) -- this is a real, reusable TUNING-PRESET system, not
;; a distinct core loop. It demonstrates taking single-player's base tuning
;; and applying "modernization" adjustments (wider hit-tolerance, an
;; auto-aim-style larger nearest-tagged range) -- a genuinely useful
;; difficulty/QoL-modifier layer any base system in this repo could reuse.

(require '[datalevin.core :as d]
         '[clojure.pprint :as pp])

(def schema
  {:profile/tag   {:db/valueType :db.type/string  :db/unique :db.unique/identity}
   :profile/r     {:db/valueType :db.type/double}
   :profile/g     {:db/valueType :db.type/double}
   :profile/b     {:db/valueType :db.type/double}
   :profile/size  {:db/valueType :db.type/double}
   :profile/glow  {:db/valueType :db.type/double}
   :profile/pulse {:db/valueType :db.type/boolean}})

(def profiles
  [{:profile/tag "player" :profile/r 0.45 :profile/g 0.78 :profile/b 1.0  :profile/size 0.045 :profile/glow 0.85 :profile/pulse true}
   {:profile/tag "enemy"  :profile/r 1.0  :profile/g 0.33 :profile/b 0.36 :profile/size 0.030 :profile/glow 0.45 :profile/pulse false}])

(def world {:player-speed 260.0 :camera-scale 620.0 :arena 460.0})
(def background {:top [0.06 0.07 0.12] :bottom [0.16 0.10 0.20] :grid 80.0})
(def burst {:count 16 :speed 220.0 :life 0.6 :color [0.6 0.9 1.0] :size 0.016})

(def db-dir (str (System/getProperty "user.dir") "/.datalevin"))

(defn -main []
  (let [conn (d/get-conn db-dir schema)]
    (d/clear conn)
    (let [conn (d/get-conn db-dir schema)]
      (d/transact! conn profiles)
      (let [rows (d/q '[:find ?tag ?r ?g ?b ?size ?glow ?pulse
                        :where
                        [?e :profile/tag ?tag]
                        [?e :profile/r ?r] [?e :profile/g ?g] [?e :profile/b ?b]
                        [?e :profile/size ?size] [?e :profile/glow ?glow]
                        [?e :profile/pulse ?pulse]]
                      (d/db conn))
            prof-map (into (sorted-map)
                           (for [[tag r g b size glow pulse] rows]
                             [(keyword tag)
                              (cond-> {:color [r g b] :size size :glow glow}
                                pulse (assoc :pulse true))]))
            scene {:game/id           :gftd.games/genre-base-modern-remake
                   :game/title        "kami-genre-base-systems / modern-remake (tuning preset)"
                   :world             world
                   :render/profiles   prof-map
                   :render/background background
                   :fx/burst          burst}
            header ";; GENERATED by author.clj -- do not hand-edit.\n\n"]
        (spit "scene.edn" (str header (with-out-str (pp/pprint scene))))
        (d/close conn)
        (println (str "author: transacted " (count profiles) " profiles, wrote scene.edn"))))))

(-main)
