(ns probe)
;; expect-value: 15

(defrecord Shape [kind :keyword w :i64 h :i64])

(defmulti area :kind)
(defmethod area :rect [s [:ref :probe/Shape]] :i64 (* (:w s) (:h s)))
(defmethod area :sq [s [:ref :probe/Shape]] :i64 (* (:w s) (:w s)))

(defn main [] :i64 (+ (area (->Shape :rect 3 2)) (area (->Shape :sq 3 3))))
