(ns probe)
;; expect-refusal: E2006
;; amu 11df09b1 (JUN-730) admits a closed defmulti, but not a fn-literal dispatch (E2006); E2003 before.

(defrecord Shape [kind :keyword w :i64 h :i64])

(defmulti area (fn [s] (:kind s)))
(defmethod area :rect [s] (* (:w s) (:h s)))
(defmethod area :sq [s] (* (:w s) (:w s)))

(defn main [] :i64 (+ (area (->Shape :rect 3 2)) (area (->Shape :sq 3 3))))
