;; KAMI Royale TPS — scene + render data.
;;
;; Forked from kami-clj-play3d/games/royale. What changed, and why:
;;
;;   :camera        27 units back and 15 up  ->  4.2 back and 1.65 up.
;;                  The old rig is an aerial diorama. At 27/15 a 1.9-unit actor
;;                  is a handful of pixels at 720p, which is why the shipped
;;                  build reads as an overhead 2D game however it is lit. This
;;                  is an over-the-shoulder boom with a shoulder offset and a
;;                  collision pullback.
;;   :camera/rig    new. Two rigs — hip and sighted — that the engine blends
;;                  between, rather than one fixed pose.
;;   :zone          new. The storm from battle_royale_storm.edn. The fork's
;;                  parent has no match clock at all: it spawns bots on a ring
;;                  forever and there is no state in which anyone has won.
;;   :loadout       new. Weapons from battle_royale_weapons.edn, a 25-row table
;;                  that has had no runtime since the Rust workspace left.
;;   :ai            new. Sight cones, hearing, memory. The parent's bots know
;;                  where the player is from 3000 units away, through walls.
;;   :player-speed  600 px/s of ground-plane input  ->  6.4 world units/s.
;;                  The parent feeds map-scale pixel velocities straight into
;;                  the axes, which is a 2D convention wearing a 3D camera.
;;
;; The host hardcodes no game content. Everything below is authored data.

{:game/id    :gftd.games/royale-tps
 :game/title "KAMI Royale"

 :world
 {:gravity 26.0
  :jump 9.5
  :ground-scale 1.0
  :collision-radius 0.55
  :eye-height 1.62}

 ;; ── camera ────────────────────────────────────────────────────────────────
 ;; Two rigs the engine interpolates between by the aim-down-sight blend. The
 ;; renderer consumes eye/target/fov and decides nothing.
 :camera/rig
 {:hip {:distance 4.2 :height 1.65 :shoulder 0.75 :fov 62.0 :look-height 1.45
        :min-distance 0.6 :pitch-min -1.15 :pitch-max 1.05}
  :ads {:distance 1.5 :height 1.55 :shoulder 0.32 :fov 42.0 :look-height 1.5}}

 :input/look-sensitivity 0.0032
 :input/ads-blend-rate 6.0

 ;; ── the match ─────────────────────────────────────────────────────────────
 :zone
 {:start-radius 900.0
  :center [0.0 0.0 0.0]
  ;; phases come from packages/kami-game-scene/resources/game_scene/battle_royale_storm.edn; naming the
  ;; file rather than copying it keeps one schedule in the workspace
  :phases :battle-royale/storm-phases}

 :match
 {:mode :solo
  :entrants 24
  :bot-spawn-radius 420.0
  ;; The parent spawns every bot at one of four fixed points chosen with
  ;; (rand-int 4). On the shipped browser host that draw returns a constant
  ;; after the first call, so in practice they all arrive from one corner in
  ;; single file. Spawning on a ring by angle removes both problems.
  :bot-spawn :ring}

 ;; ── loadout ───────────────────────────────────────────────────────────────
 ;; Indices into battle_royale_weapons.edn. Rarity decides drop frequency.
 :loadout
 {:player-start {:weapon 16 :reserve-ammo 120}   ;; common Pistol
  :bot-pool [0 5 10 13 16]                        ;; AR / shotgun / SMG / sniper / pistol
  :bot-reserve-ammo 240
  :ground-loot {:count 60 :radius 380.0 :ammo-per-drop 90}}

 ;; ── opposition ────────────────────────────────────────────────────────────
 :ai/senses
 {:sight-range 220.0
  :fov-degrees 110.0
  :hearing-range 45.0
  :gunshot-hearing-range 260.0
  :memory-seconds 4.0}

 :ai/profile
 {:preferred-range-frac 0.55
  :range-tolerance 0.22
  :aim-error-degrees 3.5
  :reaction-ms 220
  :strafe-speed-frac 0.7
  :storm-margin 12.0}

 ;; ── look ──────────────────────────────────────────────────────────────────
 ;; Unchanged from the parent except for the camera-scale values above; the
 ;; stylised toon/outline profile is already the right one for readable
 ;; silhouettes at combat distance, which matters far more now that the camera
 ;; is close enough for silhouettes to be visible at all.
 :render/camera {:fov 62.0 :near 0.1 :far 900.0}

 :render/style
 {:contract :kotoba.render/style-v1
  :profile :stylized
  :shading {:model :toon-pbr :bands 3 :threshold 0.46 :smoothness 0.06}
  :outline {:mode :screen-space :width-px 0.8 :color [0.08 0.12 0.18]
            :depth-threshold 0.18 :normal-threshold 0.90}
  :color-grading {:saturation 1.10 :contrast 1.02 :exposure 0.22}}

 :render/presets {:family :stylized}

 :render/profiles
 {:player {:color [0.30 0.62 1.00] :w 0.9 :h 1.9 :glow 0.0}
  :bot    {:color [1.00 0.34 0.32] :w 0.9 :h 1.8 :glow 0.0}
  :loot   {:color [0.98 0.82 0.28] :w 0.4 :h 0.4 :glow 0.35}}

 ;; HUD elements the engine can now actually populate, because the state they
 ;; display exists. In the parent there is nothing to show: no health, no ammo,
 ;; no survivor count, no storm.
 :render/hud
 {:crosshair {:mode :dynamic :spread-source :weapon}
  :health {:show-shield? true}
  :ammo {:show-reserve? true :show-reload-progress? true}
  :survivors true
  :zone {:ring? true :timer? true :compass? true}
  :killfeed {:lines 4 :seconds 6.0}}

 :render/props
 {:count 280 :spread 140.0
  :buildings [{:color [0.62 0.60 0.66] :min-h 2.0 :max-h 7.0 :w 2.2}
              {:color [0.70 0.66 0.55] :min-h 1.5 :max-h 4.0 :w 1.6}]
  :trees {:color [0.28 0.55 0.30] :h 2.6 :w 1.1 :ratio 0.4}}

 :render/sky
 {:zenith [0.20 0.42 0.78]
  :horizon [0.74 0.84 0.95]
  :sun-dir [-0.4 -0.85 -0.35]
  :sun [1.0 0.96 0.85]
  :fog 0.018
  :ground [0.34 0.52 0.30]}}
