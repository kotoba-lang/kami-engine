-  for (let i = 0; i < 6; i++) {
-    for (let j = 0; j < 6; j++) out[i][j] = a[i][j] + b[i][j];
-  }
-  return out;
-}
-
-function mat66Scale(a: number[][], s: number): number[][] {
-  const out = zeros66();
-  for (let i = 0; i < 6; i++) {
-    for (let j = 0; j < 6; j++) out[i][j] = a[i][j] * s;
