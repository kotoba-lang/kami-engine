-// ── Cornell-box-class scene: closed box, ceiling light, colored side walls ──
-function quad(a: Vec3, b: Vec3, c: Vec3, d: Vec3): Vec3[][] {
-  return [
-    [a, b, c],
-    [a, c, d],
-  ];
-}
