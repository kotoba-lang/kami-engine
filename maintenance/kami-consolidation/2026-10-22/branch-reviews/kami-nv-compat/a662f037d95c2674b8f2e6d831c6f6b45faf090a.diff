-    const tPos: Vec3 = [target[0], target[1], target[2]];
-    const tQuat: Quat = [target[3], target[4], target[5], target[6]];
-
-    // 1. Pose error
-    const posErr: Vec3 = [tPos[0] - eePos[0], tPos[1] - eePos[1], tPos[2] - eePos[2]];
-    const qErr = quatMul(tQuat, quatInverse(eeQuat));
