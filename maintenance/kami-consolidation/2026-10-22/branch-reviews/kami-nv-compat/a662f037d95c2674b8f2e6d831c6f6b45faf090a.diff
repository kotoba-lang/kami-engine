-      end(): void;
-    };
-    copyBufferToBuffer(s: unknown, so: number, d: unknown, dof: number, n: number): void;
-    finish(): unknown;
-  };
-  queue: {
-    writeBuffer(buf: unknown, offset: number, data: ArrayBufferView): void;
-    submit(buffers: unknown[]): void;
-  };
