-  const triBuf = mk(scene.soup.verts, STORAGE | COPY_DST);
-  const nodeBuf = mk(scene.bvh.nodes, STORAGE | COPY_DST);
-  const idxBuf = mk(scene.bvh.triIndex, STORAGE | COPY_DST);
-  const albBuf = mk(scene.mats.albedo, STORAGE | COPY_DST);
