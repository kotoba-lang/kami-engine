-    // 2. Velocity error
-    const dError = [-eeLinVel[0], -eeLinVel[1], -eeLinVel[2], -eeAngVel[0], -eeAngVel[1], -eeAngVel[2]];
-
-    // 3. Task-space wrench
-    let kpTask: readonly number[];
-    let kdRatio: readonly number[];
-    const vs = this._variableStiffness[envIdx];
