-      { binding: 1, resource: { buffer: nodeBuf } },
-      { binding: 2, resource: { buffer: idxBuf } },
-      { binding: 3, resource: { buffer: albBuf } },
-      { binding: 4, resource: { buffer: emiBuf } },
-      { binding: 5, resource: { buffer: fbBuf } },
-      { binding: 6, resource: { buffer: uniBuf } },
-    ],
-  });
