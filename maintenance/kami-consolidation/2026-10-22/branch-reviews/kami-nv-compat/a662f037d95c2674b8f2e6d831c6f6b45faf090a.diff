-  }
-  f_out[base + 0u] = 0.0;
-  f_out[base + 1u] = 0.0;
-  f_out[base + 2u] = fz;
-}
-`,
-  bindings: [
-    { binding: 0, kind: "storage", inputIndex: 0, writeback: false },
-    { binding: 1, kind: "storage", inputIndex: 1, writeback: false },
-    { binding: 2, kind: "storage", inputIndex: 2, writeback: true },
-    { binding: 3, kind: "uniform", inputIndex: 3 },
-  ],
-  workgroupSize: 64,
-});
