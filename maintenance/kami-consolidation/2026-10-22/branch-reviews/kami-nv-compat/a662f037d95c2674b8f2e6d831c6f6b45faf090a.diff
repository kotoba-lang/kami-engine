-    [c + ax * ax * oc, ax * ay * oc - az * s, ax * az * oc + ay * s],
-    [ay * ax * oc + az * s, c + ay * ay * oc, ay * az * oc - ax * s],
-    [az * ax * oc - ay * s, az * ay * oc + ax * s, c + az * az * oc],
