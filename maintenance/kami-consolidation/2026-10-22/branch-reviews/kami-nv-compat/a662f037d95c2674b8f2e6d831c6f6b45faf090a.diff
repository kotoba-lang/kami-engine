-      `<limit lower="${j.lower}" upper="${j.upper}" velocity="${j.velocity}" effort="${j.effort}"/>` +
-      `</joint>`,
-    );
-    parts.push(`<link name="panda_link${i + 1}">${inertialBlock(inert.mass, inert.com, inert.ixx, inert.iyy, inert.izz)}</link>`);
