+                 {:bubble-rect [0.6 0.02 0.95 0.3] :face-bbox [0.1 0.3 0.5 0.7]})]
+      (is (= 0.0 (:face-clear on-face)))
+      (is (= 1.0 (:face-clear clear)))
+      (is (< (:score on-face) (:score clear))))))
