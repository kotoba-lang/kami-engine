(ns kami.imports.modeling
  (:require [kami.modeling.document :as document]
            [kami.modeling.assembly :as assembly]))

(defn main []
  (let [id #(document/stable-uuid "source-import-probe" %)
        part (assembly/part (id "part") "r1" "block" {:min [-1 -1 -1] :max [1 1 1]})
        occurrence (assembly/occurrence (id "occurrence") (:part/id part))
        model (assembly/assembly (id "assembly") [part] [occurrence] [] {:default {}})
        doc (document/document (document/stable-uuid "t" "doc") :mm 0.001)]
    {:revision (:document/revision doc)
     :round-trip (= model (assembly/import-package (assembly/encode-package model)))
     :origins {:document (:file (meta #'document/document))
               :assembly (:file (meta #'assembly/import-package))}}))
